{
  "maxRedirects": 0,
  "vus": 1,
  "discardResponseBodies": true,
  "stages": [
    {
      "duration": "30s",
      "target": 70
    },
    {
      "duration": "240s",
      "target": 150
    }
  ],
  "thresholds": {
    "http_req_duration": [
      {
        "threshold": "p(95) < 5000",
        "abortOnFail": true
      }
    ],
    "checks": [
      {
        "threshold": "rate >= 1",
        "abortOnFail": true
      }
    ]
  }
}
