{
  "maxRedirects": 0,
  "vus": 1,
  "discardResponseBodies": true,
  "scenarios": {
    "ramp-up": {
      "executor": "ramping-vus",
      "startVUs": 0,
      "stages": [
        {
          "duration": "30s",
          "target": 70
        },
        {
          "duration": "4m",
          "target": 150
        }
      ],
      "gracefulRampDown": "0s",
      "gracefulStop": "30s"
    }
  },
  "thresholds": {
    "http_req_duration": [
      {
        "threshold": "p(95) < 5000",
        "abortOnFail": false
      }
    ],
    "http_req_failed": [
      {
        "threshold": "rate <= 0",
        "abortOnFail": false
      }
    ]
  }
}
